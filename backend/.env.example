NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/nexdesk
# Single database: nexdesk
# Platform collections: tenants, plans, masterusers
# Per-tenant collections: <subdomain>_users, <subdomain>_orders (e.g. abc_users, abc_orders)

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_IN=3600000

ROOT_DOMAIN=localhost
APP_SUBDOMAIN=nexdesk
ALLOW_TENANT_HEADER=true

# PayU (optional — required for live billing)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=TEST
PAYU_SUCCESS_URL=http://localhost:5173/billing/success
PAYU_FAILURE_URL=http://localhost:5173/billing/failure
BILLING_EMAIL_DOMAIN=nexdesk.local
